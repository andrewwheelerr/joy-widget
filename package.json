{
  "name": "joy-widget",
  "version": "2.0.6",
  "description": "bring me joy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.joy.widget",
    "productName": "Joy",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns"
    },
    "files": [
      "main.js",
      "button.html",
      "overlay.html",
      "audio/**",
      "assets/button.png",
      "node_modules/electron-updater/**",
      "node_modules/electron-log/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "andrewwheelerr",
      "repo": "joy-widget"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3"
  }
}
